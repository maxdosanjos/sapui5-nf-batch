{
  "name": "nf-batch",
  "version": "2.0.0",
  "description": "SAP CAP + SAP Fiori elements (SAPUI5) - Monitor e reenvio de lotes de NF-e",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-nf-batch": "cds watch --open nf-batch/webapp/index.html?sap-ui-xx-viewCache=false",
    "test": "node --test \"test/**/*.test.js\""
  },
  "sapux": [
    "app/nf-batch"
  ],
  "cds": {
    "i18n": {
      "default_language": "pt"
    },
    "requires": {
      "auth": "mocked"
